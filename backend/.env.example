DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True

POSTGRES_DB=zeal
POSTGRES_USER=zeal
POSTGRES_PASSWORD=zeal
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=Zeal <onboarding@resend.dev>

# Keep this console backend for local development. Reset and verification
# links will be printed by: docker compose logs -f backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# To deliver development email through Resend, replace EMAIL_BACKEND above with:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_your_resend_api_key
# EMAIL_USE_TLS=True
# EMAIL_TIMEOUT=10
#
# onboarding@resend.dev can normally send only to the email address associated
# with your Resend account. To email other users, verify a domain in Resend and
# set DEFAULT_FROM_EMAIL=Zeal <no-reply@your-verified-domain.com>.
